# Database settings
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=banking_system
DB_USER=postgres
DB_PASSWORD=postgres

# App settings
APP_PORT=8080

# Liquibase
LIQUIBASE_ENABLED=true

# Logging
LOG_LEVEL_COM_EXAMPLE=DEBUG
LOG_LEVEL_SPRING_SECURITY=DEBUG
LOG_LEVEL_HIBERNATE_SQL=DEBUG
LOG_LEVEL_HIBERNATE_BINDER=TRACE

# Security
ENCRYPTION_SECRET_KEY=mySuperSecretKey
JWT_SECRET=my-very-secure-key-256-bits-long-1234567890
JWT_EXPIRATION=86400000

# JPA
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true